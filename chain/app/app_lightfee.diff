 // BeginBlocker application updates every begin block
 func (app *WasmApp) BeginBlocker(ctx sdk.Context) (sdk.BeginBlock, error) {
-	return app.ModuleManager.BeginBlock(ctx)
+	resp, err := app.ModuleManager.BeginBlock(ctx)
+	if err != nil {
+		return resp, err
+	}
+	// LightDAO §4.5: refresh USD-anchored min-gas-price. ModuleManager.BeginBlock
+	// swaps in a fresh EventManager, so we run lightfee with our own EM and merge
+	// its events into the response (state is shared; only events are captured here).
+	if app.LightFeeKeeper != nil {
+		emCtx := ctx.WithEventManager(sdk.NewEventManager())
+		app.LightFeeKeeper.BeginBlock(emCtx)
+		resp.Events = append(resp.Events, emCtx.EventManager().ABCIEvents()...)
+	}
+	return resp, nil
 }
 
 // EndBlocker application updates every end block
 func (app *WasmApp) EndBlocker(ctx sdk.Context) (sdk.EndBlock, error) {
-	return app.ModuleManager.EndBlock(ctx)
+	resp, err := app.ModuleManager.EndBlock(ctx)
+	if err != nil {
+		return resp, err
+	}
+	// LightDAO §4.5: split accumulated fee_collector balance 50% burn / 20% treasury /
+	// 30% left for x/distribution to sweep to validators on next BeginBlock.
+	// Uses a fresh EventManager (module manager discarded the outer one) and merges
+	// events into the response; bank transfers still commit to the shared store.
+	if app.LightFeeKeeper != nil {
+		emCtx := ctx.WithEventManager(sdk.NewEventManager())
+		app.LightFeeKeeper.EndBlock(emCtx)
+		resp.Events = append(resp.Events, emCtx.EventManager().ABCIEvents()...)
+	}
+	return resp, nil
 }
 
